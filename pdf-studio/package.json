{
  "name": "pdf-studio-personal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.mjs\" \"vite --host 0.0.0.0 --port 5173\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs --production",
    "test": "python -m pytest tests -v",
    "test:ui": "playwright test",
    "samples": "python scripts/make_samples.py",
    "test:api": "node tests/test_api.mjs",
    "check": "python scripts/check_env.py",
    "test:capture": "node tests/test_capture.mjs",
    "test:all": "npm run check && npm run build && npm test && npm run test:validation && npm run test:api && npm run test:capture && npm run test:ui",
    "test:security": "npm audit --audit-level=moderate && python -m pip_audit -r requirements.txt",
    "test:validation": "node tests/test_security.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tiptap/extension-font-family": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-table-cell": "3.32.2",
    "@tiptap/extension-table-header": "3.32.2",
    "@tiptap/extension-table-row": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/extension-underline": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "archiver": "8.0.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.2",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "tailwindcss": "^4.1.0",
    "@tiptap/pm": "3.32.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
