# Local-only default. Use HOST=0.0.0.0 only inside a trusted sandbox/reverse proxy.
HOST=127.0.0.1
# Trusted sandbox only: allow the Arena preview iframe (keep false locally).
PREVIEW_EMBED=false
API_PORT=3001
PYTHON_PATH=python
# CHROMIUM_PATH=/usr/bin/chromium
TEMP_DIR=.studio-temp
TEMP_TTL_MINUTES=120
MAX_FILE_MB=100
MAX_SESSION_MB=1024
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MINUTES=10
